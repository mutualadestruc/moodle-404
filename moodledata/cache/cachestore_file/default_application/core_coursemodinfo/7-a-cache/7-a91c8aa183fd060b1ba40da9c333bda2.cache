O:26:"core_cache\version_wrapper":2:{s:4:"data";O:8:"stdClass":9:{s:7:"modinfo";a:28:{i:125;O:8:"stdClass":17:{s:2:"id";s:2:"24";s:2:"cm";s:3:"125";s:3:"mod";s:5:"label";s:7:"section";s:1:"0";s:13:"sectionnumber";s:1:"0";s:9:"sectionid";s:2:"38";s:6:"module";s:2:"13";s:5:"added";s:10:"1620030723";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:5:"Label";s:7:"content";s:415:"<div class="no-overflow"><p dir="ltr" style="text-align: left;"><img src="http://localhost:4000/pluginfile.php/168/mod_label/intro/Content%20created%20DigiVET4ALL%20banner.JPG?time=1620030838677" alt="Content created in Digital Vocational Education and Training for All Erasmus+ project. Co-funded by the European Union." width="1597" height="387" class="img-responsive atto_image_button_text-bottom"><br></p></div>";}i:126;O:8:"stdClass":17:{s:2:"id";s:2:"25";s:2:"cm";s:3:"126";s:3:"mod";s:5:"label";s:7:"section";s:1:"0";s:13:"sectionnumber";s:1:"0";s:9:"sectionid";s:2:"38";s:6:"module";s:2:"13";s:5:"added";s:10:"1623995937";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:53:"This course is meant to be used by educators who w...";s:7:"content";s:1125:"<div class="no-overflow"><p style="text-align: left;"><span style="color: rgb(73, 80, 87); font-size: 0.9375rem;">This course is meant to be used by educators who wish to update their old Moodle courses to meet the standards of modern pedagogy. Moodle administrators can export this course to make it available at organisation level. The content can be edited to suit organisation's needs. The intention is to follow the instructions provided in different sections for updating various aspects of an old, existing course. For the most part the idea is to follow the instructions and perform the updating steps on the old course. It may be useful to open the old course in a separate browser tab to make switching between this content and the course that is updated as easy as possible. There are also some copyable templates on this course that can be exported to the old course.</span></p>
<p style="text-align: left;"></p>
<p style="text-align: left;"></p>
<p class="c4l-spacer"></p>
<div class="c4lv-reminder " aria-label="Reminder"><span data-id="R19860-1728939580809">Lorem ipsum</span></div>
<p></p>
<p></p></div>";}i:210;O:8:"stdClass":17:{s:2:"id";s:2:"64";s:2:"cm";s:3:"210";s:3:"mod";s:5:"label";s:7:"section";s:1:"0";s:13:"sectionnumber";s:1:"0";s:9:"sectionid";s:2:"38";s:6:"module";s:2:"13";s:5:"added";s:10:"1623995937";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:60:"This course is meant to be used by educators who w... (copy)";s:7:"content";s:914:"<div class="no-overflow"><p style="text-align: left;"><span style="color: rgb(73, 80, 87); font-size: 0.9375rem;">This course {coursesummary} is meant to be used by educators who wish to update their  old Moodle courses to meet the standards of modern pedagogy. Moodle administrators can export this course to make it available at organisation level. The content can be edited to suit organisation's needs. The intention is to follow the instructions provided in different sections for updating various aspects of an old, existing course. For the most part the idea is to follow the instructions and perform the updating steps on the old course. It may be useful to open the old course in a separate browser tab to make switching between this content and the course that is updated as easy as possible. There are also some copyable templates on this course that can be exported to the old course.</span></p></div>";}i:127;O:8:"stdClass":19:{s:2:"id";s:2:"27";s:2:"cm";s:3:"127";s:3:"mod";s:3:"url";s:7:"section";s:1:"0";s:13:"sectionnumber";s:1:"0";s:9:"sectionid";s:2:"38";s:6:"module";s:2:"21";s:5:"added";s:10:"1584695957";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:148:"If your organization has a Moodle Workshop on Teams or some other distance meeting application in order to support Moodle users insert the link here";s:7:"content";s:163:"<div class="no-overflow"><p><span style="color: rgb(239, 69, 64); font-size: medium;" class="">Click the link to join the Moodle Workshop in Teams</span></p></div>";s:7:"onclick";s:90:"window.open('http://localhost:4000/mod/url/view.php?id=127&amp;redirect=1'); return false;";s:10:"customdata";a:2:{s:7:"display";s:1:"3";s:10:"filtericon";b:1;}}i:128;O:8:"stdClass":19:{s:2:"id";s:2:"28";s:2:"cm";s:3:"128";s:3:"mod";s:3:"url";s:7:"section";s:1:"0";s:13:"sectionnumber";s:1:"0";s:9:"sectionid";s:2:"38";s:6:"module";s:2:"21";s:5:"added";s:10:"1585001197";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:117:"If your organization supports Moodle users on a Teams channel or on some other discussion platform insert a link here";s:7:"content";s:107:"<div class="no-overflow"><p>Here you can get support and find solutions to questions about Moodle</p></div>";s:7:"onclick";s:90:"window.open('http://localhost:4000/mod/url/view.php?id=128&amp;redirect=1'); return false;";s:10:"customdata";a:2:{s:7:"display";s:1:"3";s:10:"filtericon";b:1;}}i:129;O:8:"stdClass":17:{s:2:"id";s:2:"14";s:2:"cm";s:3:"129";s:3:"mod";s:5:"forum";s:7:"section";s:1:"0";s:13:"sectionnumber";s:1:"0";s:9:"sectionid";s:2:"38";s:6:"module";s:1:"9";s:5:"added";s:10:"1585038829";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:9:"groupmode";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:86:"Comments, feedback and suggestions for development of this manual in your organization";s:10:"customdata";a:1:{s:12:"trackingtype";s:1:"1";}}i:208;O:8:"stdClass":17:{s:2:"id";s:2:"63";s:2:"cm";s:3:"208";s:3:"mod";s:5:"label";s:7:"section";s:1:"0";s:13:"sectionnumber";s:1:"0";s:9:"sectionid";s:2:"38";s:6:"module";s:2:"13";s:5:"added";s:10:"1727991921";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:10:"Bienvenido";s:7:"content";s:69:"<div class="no-overflow"><p>Bienvenido/a</p>
<p>{fullname}</p></div>";}i:130;O:8:"stdClass":15:{s:2:"id";s:2:"19";s:2:"cm";s:3:"130";s:3:"mod";s:4:"page";s:7:"section";s:1:"1";s:13:"sectionnumber";s:1:"1";s:9:"sectionid";s:2:"39";s:6:"module";s:2:"16";s:5:"added";s:10:"1585091440";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:28:"Contact information, example";}i:131;O:8:"stdClass":15:{s:2:"id";s:2:"20";s:2:"cm";s:3:"131";s:3:"mod";s:4:"page";s:7:"section";s:1:"1";s:13:"sectionnumber";s:1:"1";s:9:"sectionid";s:2:"39";s:6:"module";s:2:"16";s:5:"added";s:10:"1585091440";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:28:"Evaluation criteria, example";}i:132;O:8:"stdClass":17:{s:2:"id";s:2:"26";s:2:"cm";s:3:"132";s:3:"mod";s:5:"label";s:7:"section";s:1:"2";s:13:"sectionnumber";s:1:"2";s:9:"sectionid";s:2:"40";s:6:"module";s:2:"13";s:5:"added";s:10:"1585088644";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:53:"Educators should create open source learning mater...";s:7:"content";s:2163:"<div class="no-overflow"><pre><b style="white-space: inherit;">Educators should create open source learning materials, exercises and courses for their own specific fields / subjects collaboratively with other experts in the same area. For example, Educators of English work together to create content for English studies to be used collaboratively in the organisation, educators at the vehicle department create content for their respective department and so on.&nbsp;</b><br></pre><ul><li><span>The materials are based on the curricula, vocational skills requirements and evaluation criteria. The theoretical background should be the same for online courses and face-to-face teaching courses if the<span class="" style="color: rgb(51, 51, 51);"> </span><span class="" style="color: rgb(239, 69, 64);"><span class="" style="color: rgb(51, 51, 51);">subject matter</span>&nbsp;</span>is the&nbsp; same.</span></li><li><span>The way in which online courses and <span class="" style="color: rgb(51, 51, 51);">face-to-face taught</span>&nbsp;courses are carried out is different. For example the number and scope of exercises are greater in <span class="" style="color: rgb(51, 51, 51);">face-to-face taught courses</span>&nbsp;than in the online versions even if the theoretical background is the same.</span></li><li><span>The approach in this set of instructions is to steer away from teacher-specific private and "secret" courses and learning materials because the idea is to create shared common materials for the whole organisation.</span></li>
<li><span style="font-size: 0.9375rem;">All the subject matter experts</span><span style="font-size: 0.9375rem;">&nbsp;of a specific theme should create learning materials together for shared use. No </span><span class="" style="font-size: 0.9375rem; color: rgb(239, 69, 64);"><span class="" style="color: rgb(51, 51, 51);">expert willing to contribute</span></span><span style="font-size: 0.9375rem;">&nbsp;should be excluded.</span><br></li>
<li><span style="font-size: 0.9375rem;">There should be a person responsible (+ substitute) for every unit in a qualification or smaller module.</span><br></li>
</ul></div>";}i:133;O:8:"stdClass":17:{s:2:"id";s:2:"27";s:2:"cm";s:3:"133";s:3:"mod";s:5:"label";s:7:"section";s:1:"2";s:13:"sectionnumber";s:1:"2";s:9:"sectionid";s:2:"40";s:6:"module";s:2:"13";s:5:"added";s:10:"1585088644";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:53:"The learning materials and exercises that are base...";s:7:"content";s:1172:"<div class="no-overflow"><pre><strong style="font-size: small; white-space: inherit;"><span class="" style="color: rgb(51, 51, 51);">The learning materials and exercises that are based on the curricula (modules, units etc.) should be aligned to vocational requirements and evaluation criteria.</span></strong></pre><ul><li>On the one hand - all the vocational requirements and evaluation criteria should be taken into account. Things that are mentioned in the curriculum cannot be left out.</li>
<li><span style="font-size: small;">On the other hand - things that are not mentioned in the curriculum should not be included at least as mandatory content i.e. time should not be used on teaching/learning secondary content.</span><br></li>
<li><span style="font-size: small;">A good rule of thumb for planning content and exercises:</span><br></li><li>
<ul>
<li><span>MUST KNOW = sufficient grade and one that is possible for everybody to reach</span></li>
<li><span>SHOULD KNOW = good grade and one that most learners aim at</span></li>
<li><span>NICE TO KNOW = excellent grade and one that should be possible for learners to achieve&nbsp;</span></li></ul></li>
</ul></div>";}i:134;O:8:"stdClass":17:{s:2:"id";s:2:"28";s:2:"cm";s:3:"134";s:3:"mod";s:5:"label";s:7:"section";s:1:"2";s:13:"sectionnumber";s:1:"2";s:9:"sectionid";s:2:"40";s:6:"module";s:2:"13";s:5:"added";s:10:"1585088644";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:53:"Collapsed topics&nbsp;and Tiles&nbsp;formats are r...";s:7:"content";s:490:"<div class="no-overflow"><pre><b style="white-space: inherit;"><em>Collapsed topics</em><em>&nbsp;</em>and <em>Tiles</em>&nbsp;formats are recommended</b></pre><ul><li>They are clear and concise when it comes to course layout and structure</li><li><span style="font-size: small;">They are suitable for mobile use</span></li><li><span style="font-size: small;">They meet the demands of the European Accessibility directive better than <em>Grid </em>format for example</span></li>
</ul></div>";}i:135;O:8:"stdClass":17:{s:2:"id";s:2:"29";s:2:"cm";s:3:"135";s:3:"mod";s:5:"label";s:7:"section";s:1:"2";s:13:"sectionnumber";s:1:"2";s:9:"sectionid";s:2:"40";s:6:"module";s:2:"13";s:5:"added";s:10:"1585088644";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:53:"Completion progress tracking should be used on all...";s:7:"content";s:741:"<div class="no-overflow"><pre><span style="font-size: small;"><strong>Completion progress tracking should be used on all courses</strong></span></pre>
<ul>
<li><span style="font-size: 0.9375rem;">Supports the availability&nbsp;and visual aspects of the course</span><br></li>
<li><span style="font-size: small;">Helps the student keep track of progress in real-time</span><br></li>
<li><span style="font-size: small;">Helps <span class="" style="color: rgb(51, 51, 51);">the educator</span>&nbsp;to monitor learner completion progress and monitor evaluation process for groups</span><br></li>
<li><span style="font-size: 0.9375rem;">This feature has received a lot of positive feedback from learners and educators</span><br></li>
</ul></div>";}i:136;O:8:"stdClass":17:{s:2:"id";s:2:"30";s:2:"cm";s:3:"136";s:3:"mod";s:5:"label";s:7:"section";s:1:"2";s:13:"sectionnumber";s:1:"2";s:9:"sectionid";s:2:"40";s:6:"module";s:2:"13";s:5:"added";s:10:"1585170178";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:53:"Short "Welcome to the course!" Introvideo should b...";s:7:"content";s:1165:"<div class="no-overflow"><pre><strong style="white-space: inherit;"><span style="font-size: small;">Short "Welcome to the course!" Introvideo should be included at the beginning of every course</span></strong></pre>
<ul>
<li><span style="font-size: small;">The idea is to provide information on the most relevant pieces of content, course completion method, and estimated timetable for the course right at the beginning of the course</span><br></li>
<li><span style="font-size: 0.9375rem;">Short</span><span class="" style="font-size: 0.9375rem; color: rgb(239, 69, 64);"> <span class="" style="color: rgb(51, 51, 51);">span</span></span><span style="font-size: 0.9375rem;">: e.g. 1-5 minutes i.e. a concise introduction to the course</span></li><li><span style="font-size: small;">The style can be for example "talking head", screen capture video, videoed PowerPoint presentation, or something completely different, as long as the subject-matter (contents) is also spoken on top of the video content<ul><li>Tip: if you don't have the time to record and edit a video simply use PowerPoint's feature to save directly in video format</li></ul></span></li>
</ul></div>";}i:137;O:8:"stdClass":17:{s:2:"id";s:2:"31";s:2:"cm";s:3:"137";s:3:"mod";s:5:"label";s:7:"section";s:1:"2";s:13:"sectionnumber";s:1:"2";s:9:"sectionid";s:2:"40";s:6:"module";s:2:"13";s:5:"added";s:10:"1585170178";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:53:""Instructions and information on the course" secti...";s:7:"content";s:804:"<div class="no-overflow"><pre><strong style="white-space: inherit;"><span style="font-size: small;">"Instructions and information on the course" section should be included at the start of every course</span></strong><br></pre>
<ul>
<li><span style="font-size: small;">The idea is that the most relevant content, completion method, and estimated timetable for completing the course would be included at the start</span><br></li>
<li><span style="font-size: 0.9375rem;">The contact information of the educator/ person responsible should be included</span></li>
<li><span style="font-size: small;">Vocational skills requirements and evaluation criteria should be included</span><br></li>
<li><span style="font-size: small;">Also any general useful information on the course&nbsp;</span><br></li>
</ul></div>";}i:138;O:8:"stdClass":17:{s:2:"id";s:2:"32";s:2:"cm";s:3:"138";s:3:"mod";s:5:"label";s:7:"section";s:1:"2";s:13:"sectionnumber";s:1:"2";s:9:"sectionid";s:2:"40";s:6:"module";s:2:"13";s:5:"added";s:10:"1585088644";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:53:"Self evaluation and feedback at the end of every c...";s:7:"content";s:395:"<div class="no-overflow"><pre><strong style="font-size: small; white-space: inherit;">Self evaluation and feedback at the end of every course</strong></pre>
<ul>
<li><span style="font-size: small;">Very short and easy form for every course</span><br></li>
<li><span style="font-size: 0.9375rem;">The purpose is to collect feedback and development ideas for the course</span><br></li>
</ul></div>";}i:139;O:8:"stdClass":17:{s:2:"id";s:2:"33";s:2:"cm";s:3:"139";s:3:"mod";s:5:"label";s:7:"section";s:1:"2";s:13:"sectionnumber";s:1:"2";s:9:"sectionid";s:2:"40";s:6:"module";s:2:"13";s:5:"added";s:10:"1585088644";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:53:"The learning material should support different lea...";s:7:"content";s:636:"<div class="no-overflow"><pre><b style="white-space: inherit;">The learning material should support different learner types</b><br></pre>
<ul>
<li><span style="font-size: 0.9375rem;">Availability and access for all different learner types is important</span></li><li><span style="font-size: 0.9375rem;">The intro videos are a great way to make the content easy to access</span></li><li><span style="font-size: 0.9375rem;">If possible, also the texts could be included in audio format</span></li><li><span style="font-size: 0.9375rem;">If there are longer texts - summaries with the main points should be included</span></li>
</ul></div>";}i:140;O:8:"stdClass":17:{s:2:"id";s:2:"34";s:2:"cm";s:3:"140";s:3:"mod";s:5:"label";s:7:"section";s:1:"2";s:13:"sectionnumber";s:1:"2";s:9:"sectionid";s:2:"40";s:6:"module";s:2:"13";s:5:"added";s:10:"1585088644";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:53:"Re-usable courses are preferred if the content is ...";s:7:"content";s:1591:"<div class="no-overflow"><pre><span style="font-size: small;"><strong><span class="" style=""><span class="" style="color: rgb(51, 51, 51);">Re-usable courses are preferred if the content is the same</span></span></strong></span></pre>
<ul>
<li>It's better not to create a new course in Moodle every time a new run<span class="" style="color: rgb(239, 69, 64);">&nbsp;<span class="" style="color: rgb(51, 51, 51);">of the course starts again</span></span></li><li><span style="font-size: 0.9375rem;">With course's internal groups the different groups can be differentiated&nbsp;</span><span style="font-size: 0.9375rem;">and filtered from each other</span><br></li><li><span style="font-size: 0.9375rem;">The learners will use a group enrolment key to log on to the course (this replaces the general course key)</span><br></li>
<li><span size="2" style="font-size: small;">The courses' internal groups may also ease the work of assistants and coordinators (depending on the organisation)</span></li><li><span size="2" style="font-size: small;">The management of courses becomes easier</span></li><li><span size="2" style="font-size: small;">This makes completing unfinished courses easier for learners because they don't have to start from scratch every time they return to the course after a long break</span></li>
<li><span size="2" style="font-size: small;">This reduces the amount of unnecessary work for staff members due to enrolled but inactive learners&nbsp;</span></li>
<li>Using internal groups would make a great organisational policy in Moodle to unify practices</li>
</ul></div>";}i:141;O:8:"stdClass":17:{s:2:"id";s:2:"35";s:2:"cm";s:3:"141";s:3:"mod";s:5:"label";s:7:"section";s:1:"3";s:13:"sectionnumber";s:1:"3";s:9:"sectionid";s:2:"41";s:6:"module";s:2:"13";s:5:"added";s:10:"1585172626";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:53:"Check the course settings because they can have a ...";s:7:"content";s:2865:"<div class="no-overflow"><pre><strong><span style="font-size: small;">Check the course settings because they can have a drastic effect on the course features and activities</span></strong></pre>
<ul>
<li><strong><span style="font-size: small;">Course full name</span></strong><ul>
<li><span style="font-size: small;">Try to retain similarity in course names in Moodle with the ones that can be found in the study structure description elsewhere (e.g. Training prospectus)</span></li>
<li><span style="font-size: small;">Additionally, the field of studies, cluster, department, or some other relevant information can be included in the course name. This makes using search words easier.</span></li>
</ul>
</li>
<li><strong><span style="font-size: small;">Course short name</span></strong><ul>
<li><span style="font-size: small;">This can be the same as the course name --&gt; Copy-Paste the former</span></li>
</ul>
</li>
<li><strong><span style="font-size: small;">Course category</span></strong><ul>
<li><span style="font-size: small;">According to your organisation guidelines.&nbsp;</span></li>
</ul>
</li>
<li><strong><span style="font-size: small;">Start and end date</span></strong><ul>
<li><span style="font-size: small;">The end date can be turned off in most cases</span></li>
</ul>
</li>
<li><strong><span style="font-size: small;">Course description</span></strong><ul>
<li><span style="font-size: small;">Short description of the contents of the course</span></li>
<li><span style="font-size: small;">Contact information for the course tutor or educator</span></li>
<li><span style="font-size: small;">This information is visible before course enrolment</span></li>
</ul>
</li>
<li><strong><span style="font-size: small;">Course illustration image</span></strong><ul>
<li><span style="font-size: small;">Choosing the course image</span></li>
</ul>
</li>
<li><span style="font-size: small;"><strong>Course format </strong>(more on this later in a separate section)</span>
<ul>
<li><span style="font-size: small;">Collapsed Topics OR</span></li>
<li>Grid</li>
</ul>
</li>
<li><strong><span style="font-size: small;">Appearance settings</span></strong><ul>
<li><span style="font-size: small;">If the News discussion forum is not going to be used on the course, set the <em>Number of announcements</em>&nbsp;to zero (0).</span></li>
</ul>
</li>
<li><strong><span style="font-size: small;">Completion tracking</span></strong><ul>
<li><span style="font-size: small;">Enable completion tracking: Yes</span></li>
<li><span style="font-size: small;">Enables progress tracking on a course</span></li>
</ul>
</li>
<li><strong><span style="font-size: small;">Groups</span></strong><ul>
<li><span style="font-size: small;">Group mode: Separate groups</span></li>
<li><span style="font-size: small;">Enables using groups on the course</span></li></ul></li></ul></div>";}i:142;O:8:"stdClass":17:{s:2:"id";s:2:"36";s:2:"cm";s:3:"142";s:3:"mod";s:5:"label";s:7:"section";s:1:"6";s:13:"sectionnumber";s:1:"6";s:9:"sectionid";s:2:"44";s:6:"module";s:2:"13";s:5:"added";s:10:"1585096716";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:53:"Adding a Completion progress&nbsp;blockVisuals of ...";s:7:"content";s:2411:"<div class="no-overflow"><pre><strong style="white-space: inherit; font-size: small;"><pre><strong style="white-space: inherit; font-size: small;">Adding a Completion progress&nbsp;<span class="" style="color: rgb(51, 51, 51);">block</span></strong></pre><pre><strong style="white-space: inherit; font-size: small;"><span class="" style="color: rgb(51, 51, 51);">Visuals of completion tracking&nbsp;</span></strong></pre><pre><strong style="white-space: inherit; font-size: small;"><span class="" style="color: rgb(51, 51, 51);">Grading activities</span></strong><br></pre></strong></pre><p></p><ul><li>Make sure that in the course settings under "Completion Tracking" you have chosen: "Enable completion tracking: Yes"</li><li>Open the menu on the upper left corner (if it isn't open already) and at the bottom of the menu choose "Add Block" --&gt; Completion Progress</li><ul><li>The block should appear on the right hand side of the course page</li></ul><li>Click on the&nbsp; cogwheel icon&nbsp;<img src="http://localhost:4000/pluginfile.php/185/mod_label/intro/Moodle%2C%20toimintovalikko.JPG" width="18" height="18"> on right upper corner of the block --&gt; Configure Completion Progress block</li><ul><li>Order bar by: Ordering in course</li><li>How to present long bars: Wrap</li><li>Use Icons in bar: Yes</li><li>Show percentage to students: no</li><ul><li>If some <span class="" style="color: rgb(239, 69, 64);"><span class="" style="color: rgb(51, 51, 51);">activities</span>&nbsp;<span class="" style="color: rgb(51, 51, 51);">are not mandatory or if they&nbsp;have optional features, the percentage will not function correctly so it's better not to show percentage</span></span></li></ul><li><span class="" style="color: rgb(239, 69, 64);"><span class="" style="color: rgb(51, 51, 51);">Click "Show More"</span></span></li><ul><li><span class="" style="color: rgb(239, 69, 64);"><span class="" style="color: rgb(51, 51, 51);">Alternate title: If you want to name the block differently you can do that here</span></span></li><li><span class="" style="color: rgb(239, 69, 64);"><span class="" style="color: rgb(51, 51, 51);">Activities included: Either All activities with completion set OR only Selected activities (e.g. compulsory <span class="" style="color: rgb(239, 69, 64);"><span class="" style="color: rgb(51, 51, 51);">exercises</span></span>)</span></span></li></ul></ul></ul><p></p></div>";}i:143;O:8:"stdClass":17:{s:2:"id";s:2:"37";s:2:"cm";s:3:"143";s:3:"mod";s:5:"label";s:7:"section";s:1:"6";s:13:"sectionnumber";s:1:"6";s:9:"sectionid";s:2:"44";s:6:"module";s:2:"13";s:5:"added";s:10:"1585098054";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:53:"Adding completion tracking and evaluation to an ac...";s:7:"content";s:2112:"<div class="no-overflow"><pre><span style="font-size: small;"><strong>Adding completion tracking and evaluation to an activity (e.g<span class="" style="color: rgb(51, 51, 51);">. </span><span class="" style="color: rgb(51, 51, 51);">assignment</span>)</strong></span></pre>
<ul>
<li>In order to enable 'completion progress monitoring' to monitor selected activities, monitoring has to be turned on in these activities</li><ul><li>At the end of an activity (e.g. <span class="" style="">assignment<span class="" style="color: rgb(51, 51, 51);">) at the end of a </span><span class="" style="">line / row <span class="" style="color: rgb(51, 51, 51);">click on "Edit" --&gt; "Edit settings"</span></span></span></li><li><span class="" style=""><span class="" style=""><span class="" style="color: rgb(51, 51, 51);">Go to "Activity Completion" --&gt; "Completion tracking":</span></span></span></li><ul><li><span class="" style=""><span class="" style=""><span class="" style="color: rgb(51, 51, 51);">Choose: Show activity as complete when conditions are met</span></span></span></li><li><span class="" style=""><span class="" style=""><span class="" style="color: rgb(51, 51, 51);"><span class="" style="color: rgb(51, 51, 51);">Tick the box to set condition</span><span class="" style="color: rgb(51, 51, 51);">:</span>&nbsp;"Student must receive a grade to complete this activity"</span></span></span></li></ul><li><span class="" style=""><span class="" style=""><span class="" style="color: rgb(51, 51, 51);">Go to "Grade" (disclaimer: organisations may differ on grading alternatives)</span></span></span></li><ul><li><span class="" style=""><span class="" style=""><span class="" style="color: rgb(51, 51, 51);">Type: Scale</span></span></span></li><li><span class="" style=""><span class="" style=""><span class="" style="color: rgb(51, 51, 51);">Scale: <span class="" style="color: rgb(51, 51, 51);">"Completed / Not completed"</span></span></span></span></li><li><span class="" style="color: rgb(51, 51, 51);">Grade to Pass: 2</span></li></ul><li>Save and return to course</li></ul></ul><p></p><br></div>";}i:144;O:8:"stdClass":17:{s:2:"id";s:2:"38";s:2:"cm";s:3:"144";s:3:"mod";s:5:"label";s:7:"section";s:1:"8";s:13:"sectionnumber";s:1:"8";s:9:"sectionid";s:2:"46";s:6:"module";s:2:"13";s:5:"added";s:10:"1623848399";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:53:"USING TEAMS AS A VIRTUAL CLASSROOM IN MOODLEA Team...";s:7:"content";s:941:"<div class="no-overflow"><p dir="ltr" style="text-align: left;"></p><pre><b>USING TEAMS AS A VIRTUAL CLASSROOM IN MOODLE</b></pre><ul><ul><ul><ul></ul></ul></ul><li>A Teams meeting link created in Outlook can be used as a "virtual classroom" in online teaching and<span>&nbsp;</span><span>guidance</span></li><ul><li><span>Go to Outlook calendar</span></li><ul><li><span>Create a new Teams meeting --&gt; right click the link with the mouse --&gt; copy the hyper link</span></li></ul><li><span>Go to Moodle course and turn editing on</span></li><ul><li><span>Add an activity or resource --&gt; URL</span></li><ul><li><span>Name: e.g. "Virtual classroom"</span></li><li><span>External URL: Paste the Teams meeting link here</span></li><li><span>Description: e.g. Next lessons / class times --&gt; list the dates and times</span></li><li><span>Tick the box " Display description on course page"</span></li></ul></ul></ul></ul><br><p></p></div>";}i:145;O:8:"stdClass":17:{s:2:"id";s:2:"39";s:2:"cm";s:3:"145";s:3:"mod";s:5:"label";s:7:"section";s:1:"8";s:13:"sectionnumber";s:1:"8";s:9:"sectionid";s:2:"46";s:6:"module";s:2:"13";s:5:"added";s:10:"1623848489";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:53:"LINKING A MOODLE COURSE TO TEAMS AND VICE VERSAA l...";s:7:"content";s:1373:"<div class="no-overflow"><p dir="ltr" style="text-align: left;"></p><pre><b>LINKING A MOODLE COURSE TO TEAMS AND VICE VERSA</b></pre><ul><ul><ul><ul></ul></ul></ul><li>A link for a 'Teams' team channel can be opened in a Moodle course page</li><ul><li>Go to the chosen 'Teams' channel and copy the link to channel</li><li>Go to Moodle course and turn editing on</li><ul><li>Add an activity or resource --&gt; URL</li><ul><li>Name: e.g. "Link to Example channel in Teams"</li><li>External URL: Paste the Teams channel link here</li><li>Description: e.g. Next lessons / class times --&gt; list dates and times</li><li>Tick the box: "Display description on course page"</li></ul></ul></ul><li>A Moodle course page can be brought to a 'Teams' team channel as a tab</li><ul><li>Go to Moodle course page and copy the full URL in the browser's URL field (starts with https://)</li><li>Go to Teams --&gt; Choose selected team and inside the team the correct channel</li><li>Click the + sign in upper section of the channel on the right side of the tabs -&gt; choose "Page" (pink box)</li><ul><li>Name of the tab: e.g. name of the Moodle course</li><li>URL address: paste the link to Moodle course here</li><li><span>Untick the box with text along the lines of "Send a message / notify about this tab on channel"</span></li><li><span>Save</span></li></ul></ul></ul><br><p></p></div>";}i:146;O:8:"stdClass":18:{s:2:"id";s:2:"40";s:2:"cm";s:3:"146";s:3:"mod";s:5:"label";s:7:"section";s:1:"9";s:13:"sectionnumber";s:1:"9";s:9:"sectionid";s:2:"47";s:6:"module";s:2:"13";s:5:"added";s:10:"1631260473";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:53:"Use a new DigiVET4ALL H5P -template on an old cour...";s:7:"content";s:406:"<div class="no-overflow"><p dir="ltr" style="text-align: left;"></p><pre><strong>Use a new DigiVET4ALL H5P -template on an old course:</strong></pre><p></p><ol><li>Lower corner of H5P --&gt; Reuse --&gt; Load</li><li>Go to a new course --&gt; Add activity or resource --&gt; H5P --&gt; Load --&gt; Choose the H5P template on your computer</li><li>Edit the contents as you see fit</li></ol><br><p></p></div>";}i:147;O:8:"stdClass":17:{s:2:"id";s:2:"41";s:2:"cm";s:3:"147";s:3:"mod";s:5:"label";s:7:"section";s:1:"9";s:13:"sectionnumber";s:1:"9";s:9:"sectionid";s:2:"47";s:6:"module";s:2:"13";s:5:"added";s:10:"1585173453";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:53:"H5P example of learning materials that suit differ...";s:7:"content";s:395:"<div class="no-overflow"><pre><strong><span style="font-size: medium;">H5P example of learning materials that suit different learner types</span></strong></pre>
<ul><li><span style="font-size: medium;">Texts read aloud</span></li><li><span style="font-size: medium;">Summaries of longer texts</span></li><li><span style="font-size: medium;">Illustrations to suit the theme</span></li></ul></div>";}i:148;O:8:"stdClass":17:{s:2:"id";s:2:"29";s:2:"cm";s:3:"148";s:3:"mod";s:3:"url";s:7:"section";s:1:"9";s:13:"sectionnumber";s:1:"9";s:9:"sectionid";s:2:"47";s:6:"module";s:2:"21";s:5:"added";s:10:"1585035972";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:42:"More H5P examples, templates and downloads";s:7:"onclick";s:90:"window.open('http://localhost:4000/mod/url/view.php?id=148&amp;redirect=1'); return false;";s:10:"customdata";a:2:{s:7:"display";s:1:"3";s:10:"filtericon";b:1;}}i:149;O:8:"stdClass":19:{s:2:"id";s:2:"30";s:2:"cm";s:3:"149";s:3:"mod";s:3:"url";s:7:"section";s:2:"10";s:13:"sectionnumber";s:2:"10";s:9:"sectionid";s:2:"48";s:6:"module";s:2:"21";s:5:"added";s:10:"1585141668";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:30:"H5P.org - examples & downloads";s:7:"content";s:132:"<div class="no-overflow"><p><span style="font-size: 0.9375rem;">A lot of downloadable examples of H5P materials</span><br></p></div>";s:7:"onclick";s:90:"window.open('http://localhost:4000/mod/url/view.php?id=149&amp;redirect=1'); return false;";s:10:"customdata";a:2:{s:7:"display";s:1:"3";s:10:"filtericon";b:1;}}i:150;O:8:"stdClass":19:{s:2:"id";s:1:"6";s:2:"cm";s:3:"150";s:3:"mod";s:8:"feedback";s:7:"section";s:2:"11";s:13:"sectionnumber";s:2:"11";s:9:"sectionid";s:2:"49";s:6:"module";s:1:"7";s:5:"added";s:10:"1584695271";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:9:"groupmode";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:24:"An example feedback form";s:7:"content";s:161:"<div class="no-overflow"><p dir="ltr" style="text-align: left;">This example feedback form can be exported from here. It can be freely used and edited.</p></div>";s:10:"customdata";a:1:{s:9:"anonymous";s:1:"1";}}}s:12:"sectioncache";a:13:{i:38;O:8:"stdClass":6:{s:2:"id";s:2:"38";s:7:"section";s:1:"0";s:4:"name";s:8:"Welcome!";s:12:"availability";s:28:"{"op":"&","c":[],"showc":[]}";s:9:"component";N;s:6:"itemid";N;}i:39;O:8:"stdClass":7:{s:2:"id";s:2:"39";s:7:"section";s:1:"1";s:4:"name";s:60:"Instructions and information on the course - Summary Example";s:7:"summary";s:1032:"<p style="text-align: center;"><b style="font-size: 0.9375rem;"><img src="@@PLUGINFILE@@/httpspixabay.comillustrationsproblem-solution-help-support.jpg" width="300" height="200"></b><br></p>
<pre><b><span>Course content and / or learning objectives:</span><br></b><span>Briefly describe the most relevant contents of the course&nbsp;</span>(Hint! - e.g. the learning objectives from the curriculum can work fine)</pre>
<hr>
<pre><span><b>Instructions on how to study the course:<br></b>Write down instructions on how to study t<span class="" style="color: rgb(239, 69, 64);"><span class="" style="color: rgb(51, 51, 51);">he course.</span></span>&nbsp;Does the course have e.g. optional exercises, compulsory exercises, test or other conditions that have to be met in order to pass the course?&nbsp;<br></span></pre>
<hr>
<pre><span><b>Timetable / time objective for studying the course:&nbsp;<br></b></span><span>If the course has timetabled study periods it's a good idea to include this piece of information as well.</span></pre>";s:12:"availability";s:28:"{"op":"&","c":[],"showc":[]}";s:9:"component";N;s:6:"itemid";N;}i:40;O:8:"stdClass":7:{s:2:"id";s:2:"40";s:7:"section";s:1:"2";s:4:"name";s:63:"General guidelines for contact and elearning course development";s:7:"summary";s:366:"<p><span><strong><img src="@@PLUGINFILE@@/httpspixabay.comvectorscompass-direction-navigation-travel.jpg" width="100" height="108" style="display: block; margin-left: auto; margin-right: auto;"></strong></span></p>
<pre><span style="font-size: medium;"><strong>GENERAL GUIDELINES REGARDING NEW COURSES AND OLD COURSES THAT ARE BEING UPDATED<br></strong></span></pre>";s:12:"availability";s:28:"{"op":"&","c":[],"showc":[]}";s:9:"component";N;s:6:"itemid";N;}i:41;O:8:"stdClass":6:{s:2:"id";s:2:"41";s:7:"section";s:1:"3";s:4:"name";s:31:"Course settings and description";s:12:"availability";s:28:"{"op":"&","c":[],"showc":[]}";s:9:"component";N;s:6:"itemid";N;}i:42;O:8:"stdClass":7:{s:2:"id";s:2:"42";s:7:"section";s:1:"4";s:4:"name";s:13:"Course format";s:7:"summary";s:460:"<pre><span style="font-size: small;"><strong>The recommended course formats are Collapsed topics and Tiles formats&nbsp;</strong></span></pre>
<ul>
<li><span style="font-size: small;">They make the structure and visual layout of the course clear and concise</span></li>
<li><span style="font-size: small;">They are suitable for mobile use</span></li>
<li><span style="font-size: small;">The organisation colour schemes can be set up as default</span></li></ul>";s:12:"availability";s:28:"{"op":"&","c":[],"showc":[]}";s:9:"component";N;s:6:"itemid";N;}i:43;O:8:"stdClass":7:{s:2:"id";s:2:"43";s:7:"section";s:1:"5";s:4:"name";s:36:"User roles / permissions on a course";s:7:"summary";s:13482:"<pre><strong><span style="font-size: small;">Different user roles / permissions on a course</span></strong></pre>
<p><strong style="font-size: 0.9375rem;"><span style="font-size: small;">Action menu&nbsp;<img src="@@PLUGINFILE@@/Moodle%2C%20toimintovalikko.JPG">--&gt; More</span></strong><strong style="font-size: 0.9375rem;"><span style="font-size: small;">&nbsp;--&gt; Users --&gt; Enrolled users --&gt; Roles column</span></strong><br></p>
<p><strong style="font-size: 0.9375rem;"><span style="font-size: small;"><img src="data:image/png;base64," alt=""></span></strong></p><ul><li><b>Student</b></li><ul><li><span>can see materials and activities that the teacher has made visible</span></li><li><span>is a useful role for the teacher as well. This way the teacher can always see the student perspective and it is easier, among other things, to show the students how things work from their perspective</span></li></ul><li><b>Non-editing teacher</b></li><ul><li><span>Suitable role/user<span class="" style="color: rgb(51, 51, 51);">&nbsp;rights level</span><span class="" style="color: rgb(239, 69, 64);">&nbsp;<span class="" style="color: rgb(51, 51, 51);">for i.e. substitutes&nbsp;</span></span></span></li><li>Can see submissions by students</li><li>Can show and hide materials and activities</li><li>Cannot edit the course at all</li></ul><li><b>Teacher</b></li><ul><li><span>Full course editing permissions</span></li></ul><li><span style="background-color: rgb(255, 255, 255);"><a href="https://youtu.be/yCNiMjPHErA">https://youtu.be/yCNiMjPHErA</a></span><br></li></ul>";s:12:"availability";s:28:"{"op":"&","c":[],"showc":[]}";s:9:"component";N;s:6:"itemid";N;}i:44;O:8:"stdClass":6:{s:2:"id";s:2:"44";s:7:"section";s:1:"6";s:4:"name";s:41:"Completion Tracking and activity settings";s:12:"availability";s:28:"{"op":"&","c":[],"showc":[]}";s:9:"component";N;s:6:"itemid";N;}i:45;O:8:"stdClass":7:{s:2:"id";s:2:"45";s:7:"section";s:1:"7";s:4:"name";s:35:"Course settings and creating groups";s:7:"summary";s:2365:"<pre><strong style="font-size: small; white-space: inherit;">COURSE SETTINGS AND CREATING A GROUP</strong></pre>
<p></p><p>Using groups on courses is recommended. By using groups you can use one course instead of making copies of the same course over and over again for new learner groups. The number of groups on a course are not restricted. Groups enable one course to have hundreds of learners without learner management and evaluation becoming overtly complicated. The group naming policy should be decided together by the educators who use the same course. The naming policy should be such that relevant information is included in the group names. For example, if the course in question is offered to the learners during certain dates, the group names could reflect this. The groups could be named "Feb 1 2022 - March 1 2022". The next group could be "April 1 2022 - May 1 2022" to reflect the time frame when the course is available again. If the course was used by learners of several different study programmes the group names could reflect this. For example "Business 2022", "Healthcare 2022" etc. The most important thing to remember is that the naming policy is uniform within the course and that all educators understand the importance and logic behind the naming policy.</p><p>Each group that is created will have its own group enrolment key (NB! The course will not have a separate course enrolment key as the group enrolment key is used instead). When the learners get their enrolment keys, the key they use directs them to their own group. In other words, the learners are grouped based on the keys they use. The keys can be sent to the learner groups via email or some other messaging system. The benefit of this enrolment method is that the educator / assistant / coordinator saves precious time as there is no need to enrol learners on the course manually one by one any more. Instead the leaners will now appear on the course by using the group enrolment key to enrol themselves on the course.</p><p>By using groups the educators can filter the relevant groups of learners from the larger cohort of course participants. This works for evaluation and completion progress monitoring as well. Activities and resources can be hidden / made visible to different groups. Learners get to see content based on which groups they belong to.</p><br><p></p>";s:12:"availability";s:28:"{"op":"&","c":[],"showc":[]}";s:9:"component";N;s:6:"itemid";N;}i:46;O:8:"stdClass":7:{s:2:"id";s:2:"46";s:7:"section";s:1:"8";s:4:"name";s:36:"Online guidance with Microsoft Teams";s:7:"summary";s:165:"<pre><strong><span style="font-size: small;">Disclaimer: not all organisations use 'Teams' as their platform for distance learning and teaching</span></strong></pre>";s:12:"availability";s:28:"{"op":"&","c":[],"showc":[]}";s:9:"component";N;s:6:"itemid";N;}i:47;O:8:"stdClass":6:{s:2:"id";s:2:"47";s:7:"section";s:1:"9";s:4:"name";s:56:"Enhancing study materials and different learner profiles";s:12:"availability";s:28:"{"op":"&","c":[],"showc":[]}";s:9:"component";N;s:6:"itemid";N;}i:48;O:8:"stdClass":6:{s:2:"id";s:2:"48";s:7:"section";s:2:"10";s:4:"name";s:14:"Tips and Links";s:12:"availability";N;s:9:"component";N;s:6:"itemid";N;}i:49;O:8:"stdClass":6:{s:2:"id";s:2:"49";s:7:"section";s:2:"11";s:4:"name";s:53:"SELF EVALUATION AND FEEDBACK (Introtexts to be added)";s:12:"availability";s:28:"{"op":"&","c":[],"showc":[]}";s:9:"component";N;s:6:"itemid";N;}i:50;O:8:"stdClass":6:{s:2:"id";s:2:"50";s:7:"section";s:2:"12";s:4:"name";s:19:"SECTION FOR TESTING";s:12:"availability";N;s:9:"component";N;s:6:"itemid";N;}}s:9:"shortname";s:44:"DigiVET - How to tune your old Moodle Course";s:8:"fullname";s:44:"DigiVET - How to tune your old Moodle Course";s:6:"format";s:5:"weeks";s:16:"enablecompletion";s:1:"1";s:9:"groupmode";s:1:"0";s:14:"groupmodeforce";s:1:"0";s:8:"cacherev";s:10:"1730928111";}s:7:"version";i:1730928111;}