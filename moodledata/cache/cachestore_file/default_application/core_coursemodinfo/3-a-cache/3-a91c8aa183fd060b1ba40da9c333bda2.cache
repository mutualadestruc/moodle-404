lay";i:4;s:10:"filtericon";b:1;}}i:49;O:8:"stdClass":18:{s:2:"id";s:2:"16";s:2:"cm";s:2:"49";s:3:"mod";s:3:"url";s:7:"section";s:1:"5";s:13:"sectionnumber";s:1:"5";s:9:"sectionid";s:2:"14";s:6:"module";s:2:"21";s:5:"added";s:10:"1614951577";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:32:"H5P-content examples & downloads";s:7:"content";s:192:"<div class="no-overflow"><p>H5P makes it easy to create interactive content by providing a range of content types for various needs. Preview and explore these content types here.<br></p></div>";s:10:"customdata";a:2:{s:7:"display";i:4;s:10:"filtericon";b:1;}}}s:12:"sectioncache";a:7:{i:9;O:8:"stdClass":7:{s:2:"id";s:1:"9";s:7:"section";s:1:"0";s:4:"name";s:10:"Welcome...";s:7:"summary";s:647:"<p style="text-align: center;"><strong><span class="" style="color: rgb(255, 51, 102);"><img class="img-responsive atto_image_button_text-bottom" role="presentation" src="@@PLUGINFILE@@/Content%20created%20DigiVET4ALL%20banner.JPG" alt="Content created in DigiVET4ALL project banner" width="1200" height="291">Add a short (1-5 min.) "Welcome to the course" video or some other visual element that goes well with the topic.</span><br></strong></p>
