O:26:"core_cache\version_wrapper":2:{s:4:"data";O:8:"stdClass":9:{s:7:"modinfo";a:24:{i:26;O:8:"stdClass":17:{s:2:"id";s:1:"3";s:2:"cm";s:2:"26";s:3:"mod";s:4:"page";s:7:"section";s:1:"0";s:13:"sectionnumber";s:1:"0";s:9:"sectionid";s:1:"9";s:6:"module";s:2:"16";s:5:"added";s:10:"1549625363";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"0";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:30:"Manual for the Course Template";s:7:"onclick";s:220:"window.open('http://localhost:4000/mod/page/view.php?id=26&amp;inpopup=1', '', 'width=620,height=800,toolbar=no,location=no,menubar=no,copyhistory=no,status=no,directories=no,scrollbars=yes,resizable=yes'); return false;";}i:27;O:8:"stdClass":19:{s:2:"id";s:1:"4";s:2:"cm";s:2:"27";s:3:"mod";s:5:"forum";s:7:"section";s:1:"1";s:13:"sectionnumber";s:1:"1";s:9:"sectionid";s:2:"10";s:6:"module";s:1:"9";s:5:"added";s:10:"1588146124";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:10:"completion";s:1:"2";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:13:"Give feedback";s:7:"content";s:56:"<div class="no-overflow"><p>Instructions&nbsp;</p></div>";s:10:"customdata";a:2:{s:21:"customcompletionrules";a:3:{s:21:"completiondiscussions";s:1:"1";s:17:"completionreplies";s:1:"2";s:15:"completionposts";s:1:"0";}s:12:"trackingtype";s:1:"1";}}i:28;O:8:"stdClass":17:{s:2:"id";s:1:"6";s:2:"cm";s:2:"28";s:3:"mod";s:5:"label";s:7:"section";s:1:"1";s:13:"sectionnumber";s:1:"1";s:9:"sectionid";s:2:"10";s:6:"module";s:2:"13";s:5:"added";s:10:"1618568384";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:53:"Essential content:Describe in a concise and clear ...";s:7:"content";s:943:"<div class="no-overflow"><p><pre><b>Essential content:<br></b><span>Describe in a concise and clear manner the essential content and structure of the course. This section serves as an overview and a reminder for the student at the beginning of the course, therefore the text should be as short as possible. A longer and more detailed description should be done as a separate section.&nbsp;</span><hr><b>Goals and instructions:<br></b><span>Desrcibe the aims and goals of the course along with all other pivotal information regarding the course i.e. if there's a quiz or other criteria for completing the course. Is there a certificate at the end? Is it mandatory to renew the course after a time period?<br></span>You should also describe possible assignments and material.<hr><b>Schedule or required time:<br></b>If there's a set schedule, describe it here as well as an estimate of the time it takes to finish the course.</pre><br></p></div>";}i:29;O:8:"stdClass":18:{s:2:"id";s:1:"6";s:2:"cm";s:2:"29";s:3:"mod";s:6:"assign";s:7:"section";s:1:"2";s:13:"sectionnumber";s:1:"2";s:9:"sectionid";s:2:"11";s:6:"module";s:1:"1";s:5:"added";s:10:"1588146927";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:10:"completion";s:1:"2";s:25:"completiongradeitemnumber";s:1:"0";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:10:"Assignment";s:10:"customdata";a:1:{s:21:"customcompletionrules";a:1:{s:16:"completionsubmit";s:1:"0";}}}i:30;O:8:"stdClass":18:{s:2:"id";s:1:"7";s:2:"cm";s:2:"30";s:3:"mod";s:6:"assign";s:7:"section";s:1:"2";s:13:"sectionnumber";s:1:"2";s:9:"sectionid";s:2:"11";s:6:"module";s:1:"1";s:5:"added";s:10:"1588146927";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:10:"completion";s:1:"2";s:25:"completiongradeitemnumber";s:1:"0";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";N;s:4:"name";s:11:"Assignment2";s:10:"customdata";a:1:{s:21:"customcompletionrules";